# Скопируйте в .env: `cp .env.example .env`. Все переменные опциональны.

# SQLAlchemy URL с асинхронным драйвером (для локального запуска без compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/rl_arena
REDIS_URL=redis://localhost:6380/0

# development | test | staging | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# text — для глаз, json — для сборщиков логов
LOG_FORMAT=text

# Лига: раз в сколько эпох пересоздавать эксплоитеров и сколько их держать
EXPLOITER_RESAMPLE_EVERY=5
EXPLOITERS_PER_LEAGUE=2

# Креды Postgres для docker compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rl_arena
