# Скопируйте в .env: `cp .env.example .env`. Все переменные опциональны.

# Tracking server для пайплайна и сервиса
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_DISABLE_AGENT_HINT=1
# Артефакты только через прокси сервера: иначе клиент получает presigned-URL
# на адрес S3 внутри compose-сети (http://s3:9000), недоступный снаружи
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false
MLFLOW_ENABLE_PROXY_MULTIPART_UPLOAD=false

# Каталог проекта Kaggriculture с реплеями и сабмитами
KAGGRICULTURE_DIR=/home/smirnolegov/kaggriculture
# Число процессов для разбора реплеев и игр лиги
WORKERS=8

# Inference-сервис: какую модель и по какому alias грузить на старте
MODEL_NAME=kaggriculture-winprob
MODEL_ALIAS=champion
LOG_LEVEL=INFO

# Креды для docker compose
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow
S3_ACCESS_KEY=mlflow
S3_SECRET_KEY=mlflow-secret
