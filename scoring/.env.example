# Скопируйте в .env: `cp .env.example .env`. Все переменные опциональны.
# docker compose берёт отсюда параметры очереди, OTEL_SDK_DISABLED, LOG_LEVEL, REPLAYS_DIR
# и версии образов; адреса RabbitMQ, Postgres и Collector в контейнерах свои, из compose.yaml.
# Адреса ниже нужны процессам на хосте (`make api`, `make worker`, `make source`).

RABBIT_URL=amqp://guest:guest@localhost:5672/
DATABASE_URL=postgresql+asyncpg://scoring:scoring@localhost:5435/scoring

QUEUE_NAME=tasks
QUEUE_MAX_LENGTH=100
DELIVERY_LIMIT=3

PREFETCH_COUNT=4
WORKER_THREADS=4
INFERENCE_DELAY_S=0.2
# Конкурентность задаёт пул воркера; OpenMP внутри HGB с ним только конкурирует
OMP_NUM_THREADS=1

MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_DISABLE_AGENT_HINT=1
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false
MODEL_NAME=kaggriculture-winprob
MODEL_ALIAS=champion

# Реплеи, которые скорит источник: REPLAYS для процесса на хосте, REPLAYS_DIR монтируется в контейнер
REPLAYS=../mlflow/data/league/replays
REPLAYS_DIR=../mlflow/data/league/replays

# Логи и телеметрия
LOG_LEVEL=INFO
# Без стека наблюдаемости SDK пишет в лог предупреждения о неудачном экспорте; true их убирает
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=scoring
# Стенд: все трейсы. Прод — в README, раздел «Семплирование»
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRIC_EXPORT_INTERVAL=5000
OTEL_SEMCONV_STABILITY_OPT_IN=http
APP_VERSION=0.2.0
DEPLOY_ENV=local

# Стек наблюдаемости
GRAFANA_ADMIN_PASSWORD=admin
OTEL_COLLECTOR_VERSION=0.130.0
TEMPO_VERSION=2.8.2
LOKI_VERSION=3.5.7
VECTOR_VERSION=0.48.0-alpine
PROMETHEUS_VERSION=v3.5.0
GRAFANA_VERSION=12.1.1
