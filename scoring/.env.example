# Скопируйте в .env: `cp .env.example .env`. Все переменные опциональны.

RABBIT_URL=amqp://guest:guest@localhost:5672/
DATABASE_URL=postgresql+asyncpg://scoring:scoring@localhost:5435/scoring

QUEUE_NAME=tasks
QUEUE_MAX_LENGTH=100
DELIVERY_LIMIT=3

PREFETCH_COUNT=4
WORKER_THREADS=4
INFERENCE_DELAY_S=0.2
# Конкурентность задаёт пул воркера; OpenMP внутри HGB с ним только конкурирует
OMP_NUM_THREADS=1

MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_DISABLE_AGENT_HINT=1
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false
MODEL_NAME=kaggriculture-winprob
MODEL_ALIAS=champion

# Реплеи, которые скорит источник
REPLAYS=../mlflow/data/league/replays
