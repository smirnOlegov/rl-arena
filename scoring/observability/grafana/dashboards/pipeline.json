            "fillOpacity": 20,
            "showPoints": "never",
            "axisLabel": "задач/с",
            "axisPlacement": "left",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
