{
  "uid": "scoring-pipeline",
  "title": "Конвейер",
  "description": "Источник → очередь RabbitMQ → воркеры → Postgres; эксперимент с противодавлением в живом виде",
  "tags": [
    "scoring"
  ],
  "timezone": "browser",
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "queue",
        "label": "Очередь",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(scoring_queue_max_length, queue)",
          "refId": "queue"
        },
        "definition": "label_values(scoring_queue_max_length, queue)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "tasks",
          "value": "tasks"
        }
      },
      {
        "name": "service",
        "label": "Сервис",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(process_memory_usage_bytes, job)",
          "refId": "service"
        },
        "definition": "label_values(process_memory_usage_bytes, job)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "scoring-.+"
      },
      {
        "name": "worker",
        "label": "Воркер",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(scoring_worker_tasks_total, instance)",
          "refId": "worker"
        },
        "definition": "label_values(scoring_worker_tasks_total, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Очередь и пропускная способность",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Глубина очереди $queue",
      "description": "Из Prometheus-плагина RabbitMQ (rabbitmq_detailed_queue_*). Лимит x-max-length считает только ready; quorum-очередь пропускает одно сообщение сверх лимита.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisLabel": "сообщений",
            "axisPlacement": "left",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "лимит x-max-length"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rabbitmq_detailed_queue_messages_ready{queue=\"$queue\"})",
          "legendFormat": "ready",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rabbitmq_detailed_queue_messages_unacked{queue=\"$queue\"})",
          "legendFormat": "unacked (в воркерах)",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(scoring_queue_max_length{queue=\"$queue\"})",
          "legendFormat": "лимит x-max-length",
          "refId": "C",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Источник против воркеров",
      "description": "Скорость, с которой брокер принимает задачи источника, и суммарная скорость успешной обработки. При полной очереди линии совпадают: источник идёт со скоростью воркеров.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: задач/с",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "axisLabel": "задач/с",
            "axisPlacement": "left",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(scoring_source_published_total[$__rate_interval]))",
          "legendFormat": "источник",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(scoring_worker_tasks_total{result=\"ok\"}[$__rate_interval]))",
          "legendFormat": "воркеры, всего",
          "refId": "B",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Пропускная способность по воркерам",
      "description": "Успешно обработанные задачи по service.instance.id воркера.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
